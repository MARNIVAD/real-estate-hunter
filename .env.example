# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в репозиторий (см. .gitignore).

# Токен Telegram-бота от @BotFather (обязательно)
BOT_TOKEN=

# Строка подключения к PostgreSQL.
# Можно указывать postgres:// или postgresql:// — приложение само добавит драйвер asyncpg.
# Пример локально: postgresql+asyncpg://postgres:postgres@localhost:5432/danang_bot
# Пример Render: postgresql://user:password@host/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@loc

# Ключ OpenAI (необязательно). Без него бот работает в mock-режиме извлечения слотов.
OPENAI_API_KEY=

# Telegram ID администратора (необязательно, зарезервировано для будущих функций)
ADMIN_TELEGRAM_ID=

# Необязательные настройки (можно не указывать)
# OPENAI_MODEL=gpt-4o-mini
# USD_VND_RATE=25000
